{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentxp.dev/a2ui/catalogs/winforms/v1",
  "title": "AgentXP WinForms Catalog",
  "description": "Windows XP WinForms style controls for agent-drawn A2UI surfaces in AgentXP.",
  "catalogId": "https://agentxp.dev/a2ui/catalogs/winforms/v1",
  "instructions": "Draw interactive Windows XP WinForms style UI with a2ui_render, using A2UI v0.9 messages. The tool's target argument chooses where a new surface appears: inline in the chat (default), in a sidebar beside the chat, or in its own desktop window (theme.width / theme.height in pixels hint the window size).\nSend messages of the shape {\"version\":\"v0.9\", ...} with exactly one of createSurface, updateComponents, updateDataModel or deleteSurface.\ncreateSurface needs surfaceId and this catalog's catalogId; theme.title sets the surface caption. updateComponents upserts a flat list of components by id; the root component must have id \"root\" and containers reference children by id.\nDynamic properties accept a literal, a data binding {\"path\": \"/json/pointer\"} or a function call; inputs write edits back to the data model. Use the formatString function for interpolation, e.g. {\"call\":\"formatString\",\"args\":{\"value\":\"Hello ${/name}\"},\"returnType\":\"string\"}.\nActions are {\"event\": {\"name\": \"submit\", \"context\": {\"name\": {\"path\": \"/name\"}}}}; when the user triggers one, AgentXP sends you the action with its context resolved and the current data model as a new prompt.\nupdateDataModel writes value at path (the whole model when path is omitted; omit value to delete the key). To change an existing surface re-send updateComponents with the same ids and/or updateDataModel; send createSurface only once per surfaceId (deleteSurface first to start over).",
  "components": {
    "Panel": {
      "type": "object",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "description": "Container that stacks its children vertically, like a WinForms Panel. Use it as the surface root.",
          "properties": {
            "component": {
              "const": "Panel"
            },
            "children": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList",
              "description": "Ids of the child components, in order, or a template over a data list."
            },
            "borderStyle": {
              "type": "string",
              "enum": [
                "None",
                "FixedSingle",
                "Fixed3D"
              ],
              "description": "Border style.",
              "default": "None"
            },
            "autoScroll": {
              "type": "boolean",
              "description": "Show scrollbars when the content overflows."
            }
          },
          "required": [
            "component",
            "children"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "FlowLayoutPanel": {
      "type": "object",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "description": "Flows its children left to right or top down, optionally wrapping, like a WinForms FlowLayoutPanel.",
          "properties": {
            "component": {
              "const": "FlowLayoutPanel"
            },
            "children": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ChildList",
              "description": "Ids of the child components, in order, or a template over a data list."
            },
            "flowDirection": {
              "type": "string",
              "enum": [
                "LeftToRight",
                "TopDown"
              ],
              "description": "Direction the children flow in.",
              "default": "LeftToRight"
            },
            "wrap": {
              "type": "boolean",
              "description": "Wrap children to the next row or column when space runs out."
            },
            "gap": {
              "type": "number",
              "description": "Gap between children in px.",
              "minimum": 0
            }
          },
          "required": [
            "component",
            "children"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "TableLayoutPanel": {
