              "const": "PictureBox"
            },
            "src": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Image URL or data: URI."
            },
            "sizeMode": {
              "type": "string",
              "enum": [
                "Normal",
                "StretchImage",
                "Zoom",
                "CenterImage"
              ],
              "description": "How the image is fitted.",
              "default": "Normal"
            },
            "width": {
              "type": "number",
              "description": "Width in px (default 100).",
              "minimum": 1
            },
            "height": {
              "type": "number",
              "description": "Height in px (default 100).",
              "minimum": 1
            }
          },
          "required": [
            "component",
            "src"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "TreeView": {
      "type": "object",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "description": "Hierarchical tree.",
          "properties": {
            "component": {
              "const": "TreeView"
            },
            "nodes": {
              "$ref": "#/$defs/DynamicTreeNodes",
              "description": "Root nodes."
            },
            "selected": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Id of the selected node. Bind with {\"path\": ...} for two-way selection."
            }
          },
          "required": [
            "component",
            "nodes"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "ListView": {
      "type": "object",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "description": "Multi-column list with sortable headers.",
          "properties": {
            "component": {
              "const": "ListView"
            },
            "columns": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ListColumn"
              },
              "description": "Columns (Details view)."
            },
            "rows": {
              "$ref": "#/$defs/DynamicRows",
              "description": "Rows: objects keyed by column key, each with a unique \"id\" and an optional \"icon\"."
            },
            "view": {
              "type": "string",
              "enum": [
                "Details",
                "List",
                "SmallIcon",
                "LargeIcon"
              ],
              "description": "View mode.",
              "default": "Details"
            },
            "selected": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicStringList",
              "description": "Ids of the selected rows. Bind with {\"path\": ...} for two-way selection."
            },
            "multiSelect": {
              "type": "boolean",
              "description": "Allow selecting several rows."
            }
          },
          "required": [
            "component",
            "rows"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "DataGridView": {
      "type": "object",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "description": "Editable table.",
          "properties": {
            "component": {
              "const": "DataGridView"
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/GridColumn"
              },
              "description": "Column definitions."
            },
            "rows": {
              "$ref": "#/$defs/DynamicRows",
              "description": "Rows: objects keyed by column key. Bind with {\"path\": ...} to receive cell edits."
            },
            "readOnly": {
              "type": "boolean",
              "description": "Disable editing."
            }
          },
          "required": [
            "component",
            "columns",
            "rows"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "PropertyGrid": {
      "type": "object",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "description": "Property sheet with categories and typed editors.",
          "properties": {
            "component": {
              "const": "PropertyGrid"
            },
            "properties": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PropertyDef"
              },
              "description": "Property definitions."
            },
            "values": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicValue",
              "description": "Object holding the property values by key. Bind with {\"path\": ...} for two-way editing."
            }
          },
          "required": [
            "component",
            "properties",
            "values"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "CodeViewer": {
      "type": "object",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "description": "Read-only source code with syntax highlighting.",
          "properties": {
            "component": {
              "const": "CodeViewer"
            },
            "code": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Source code."
            },
            "language": {
              "type": "string",
              "description": "Language id, e.g. \"typescript\"."
            },
            "highlightLines": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "description": "1-based line numbers to highlight."
            }
          },
          "required": [
            "component",
            "code"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "DiffViewer": {
      "type": "object",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "description": "Shows changes to a file, either as a unified diff or as an old/new text pair.",
          "properties": {
            "component": {
              "const": "DiffViewer"
            },
            "path": {
              "type": "string",
              "description": "File path shown in the header."
            },
            "oldText": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Original text (use together with newText)."
            },
            "newText": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Modified text (use together with oldText)."
            },
            "diff": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Unified diff text, as an alternative to oldText and newText."
            },
            "mode": {
              "type": "string",
              "enum": [
                "unified",
                "split"
              ],
              "description": "Initial view mode.",
              "default": "unified"
            }
          },
          "required": [
            "component"
          ],
          "anyOf": [
            {
              "required": [
                "diff"
              ]
            },
            {
              "required": [
                "oldText",
                "newText"
              ]
            }
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "ConsoleView": {
      "type": "object",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "description": "Monospace console output; ANSI colour codes are rendered.",
          "properties": {
            "component": {
              "const": "ConsoleView"
            },
            "text": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Console output."
            },
            "running": {
              "type": "boolean",
              "description": "Show a blinking cursor while the process runs."
            }
          },
          "required": [
            "component",
            "text"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "Markdown": {
      "type": "object",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "description": "Rendered Markdown text.",
          "properties": {
            "component": {
              "const": "Markdown"
            },
            "text": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Markdown source."
            }
          },
          "required": [
            "component",
            "text"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "MessageBoxPanel": {
      "type": "object",
      "allOf": [
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "description": "Inline message box: icon, message text and action buttons.",
          "properties": {
            "component": {
              "const": "MessageBoxPanel"
            },
            "icon": {
              "type": "string",
              "enum": [
                "info",
                "warning",
                "error",
                "question"
              ],
              "description": "Message icon.",
              "default": "info"
            },
            "text": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString",
              "description": "Message."
            },
            "buttons": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "text": {
