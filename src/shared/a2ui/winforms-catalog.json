              "description": "Number of columns."
            },
            "columnWidths": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "description": "Width per column: a px number, \"auto\" or a percentage such as \"50%\"."
            }
          },
          "required": [
            "component",
            "children",
            "columns"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "GroupBox": {
