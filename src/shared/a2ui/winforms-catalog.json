  },
  "$defs": {
    "CatalogComponentCommon": {
      "type": "object",
      "properties": {
        "enabled": {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicBoolean",
          "description": "Whether the control accepts input (default true)."
        }
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Caption of the surface, shown in its title bar."
        }
      },
      "additionalProperties": true
    },
    "Option": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          },
          "required": [
            "value"
          ],
          "additionalProperties": false
        }
      ],
      "description": "A choice: a plain string, or an object with a value and an optional label."
    },
    "DynamicOptions": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Option"
          }
        },
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DataBinding"
        },
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/FunctionCall"
        }
      ],
      "description": "A list of choices, a data binding to one, or a function call returning one."
    },
    "TreeNode": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique node id."
        },
        "text": {
          "type": "string",
          "description": "Node caption."
        },
        "icon": {
          "type": "string",
          "description": "Kit icon name."
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TreeNode"
          }
        }
      },
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false
    },
    "DynamicTreeNodes": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TreeNode"
          }
        },
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DataBinding"
        },
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/FunctionCall"
        }
      ],
      "description": "A list of tree nodes, a data binding to one, or a function call returning one."
    },
    "ListColumn": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "Row property shown in this column."
        },
        "header": {
          "type": "string",
          "description": "Column header text."
        },
        "width": {
          "type": "number",
          "description": "Width in px; omitted means flexible.",
          "minimum": 1
        },
        "align": {
          "type": "string",
          "enum": [
            "left",
            "right",
            "center"
          ],
          "description": "Text alignment."
        },
        "sortable": {
          "type": "boolean",
          "description": "Whether clicking the header sorts (default true)."
        }
      },
      "required": [
        "key",
        "header"
      ],
      "additionalProperties": false
    },
    "GridColumn": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "Row property shown in this column."
        },
        "header": {
          "type": "string",
          "description": "Column header text."
        },
        "width": {
          "type": "number",
          "description": "Width in px (default 100).",
          "minimum": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "text",
            "number",
            "checkbox",
            "combo"
          ],
          "description": "Cell editor type.",
          "default": "text"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Option"
          },
          "description": "Choices of a combo column."
        },
        "readOnly": {
          "type": "boolean",
          "description": "Disable editing of this column."
        }
      },
      "required": [
        "key",
        "header"
      ],
      "additionalProperties": false
    },
    "PropertyDef": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "Key of the value in the values object."
        },
        "name": {
          "type": "string",
          "description": "Display name (default: key)."
        },
        "category": {
          "type": "string",
          "description": "Category heading (default \"Misc\")."
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "boolean",
            "enum"
          ],
          "description": "Editor type.",
          "default": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Choices of an enum property."
        },
        "description": {
          "type": "string",
          "description": "Help text shown under the grid."
        },
        "readOnly": {
          "type": "boolean",
          "description": "Disable editing of this property."
        }
      },
      "required": [
        "key"
      ],
      "additionalProperties": false
    },
    "DynamicRows": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DataBinding"
        },
        {
          "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/FunctionCall"
        }
      ],
      "description": "A list of row objects, a data binding to one, or a function call returning one."
    }
  }
}
