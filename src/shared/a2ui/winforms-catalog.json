                  },
                  "action": {
                    "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/Action",
                    "description": "Action fired when the button is clicked."
                  }
                },
                "required": [
                  "text",
                  "action"
                ],
                "additionalProperties": false
              },
              "description": "Buttons, each firing an action."
