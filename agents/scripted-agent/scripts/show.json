{
  "$schema": "../script.schema.json",
  "name": "show",
  "description": "Show and the agent cursor for e2e/show.e2e.ts (the project at E:\\ has auth.ts with 12 lines). \"show the token check\" calls show on E:\\auth.ts lines 3-5 with a note. \"background show\" pauses before its show (the test moves the focus to another window), then calls show on lines 8-9: a request. \"show the end\" shows line 12 (near the bottom of the window). \"show the board\" shows the Kanban window. Anything else answers at once.",
  "agent": {
    "name": "scripted-agent",
    "version": "1.0.0"
  },
  "rules": [
    {
      "id": "token",
      "match": { "contains": "show the token check", "ignoreCase": true },
      "steps": [
        {
          "type": "mcpCall",
          "server": "agentxp",
          "tool": "show",
          "arguments": { "target": { "kind": "file", "path": "E:\\auth.ts", "lines": [3, 5] }, "note": "Here the token is checked before it expires" },
          "saveAs": "shown"
        },
        { "type": "expect", "from": "shown.isError", "equals": "false" },
        { "type": "message", "text": "{{shown}}" }
      ]
    },
    {
      "id": "background",
      "match": { "contains": "background show", "ignoreCase": true },
      "steps": [
        { "type": "message", "text": "Looking into it.\n" },
        {
          "type": "mcpCall",
          "server": "agentxp",
          "tool": "show",
          "step": "manual",
          "label": "show",
          "arguments": { "target": { "kind": "file", "path": "E:\\auth.ts", "lines": [8, 9] }, "note": "This branch never runs" },
          "saveAs": "asked"
        },
        { "type": "expect", "from": "asked.isError", "equals": "false" },
        { "type": "message", "text": "{{asked}}" }
      ]
    },
    {
      "id": "end",
      "match": { "contains": "show the end", "ignoreCase": true },
      "steps": [
        {
          "type": "mcpCall",
          "server": "agentxp",
          "tool": "show",
          "arguments": { "target": { "kind": "file", "path": "E:\\auth.ts", "lines": [12, 12] }, "note": "The last line exports it" },
          "saveAs": "shown"
        },
        { "type": "message", "text": "{{shown}}" }
      ]
    },
    {
      "id": "board",
      "match": { "contains": "show the board", "ignoreCase": true },
      "steps": [
        {
          "type": "mcpCall",
          "server": "agentxp",
          "tool": "show",
          "arguments": { "target": { "kind": "window", "app": "kanban" }, "note": "The plan is on the board" },
          "saveAs": "shown"
        },
        { "type": "message", "text": "{{shown}}" }
      ]
    },
    {
      "id": "fallback",
      "match": { "any": true },
      "steps": [{ "type": "message", "text": "Nothing to do." }]
    }
  ]
}
