{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentXP scripted agent script",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "agent",
    "rules"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "agent": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "modes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "name"
            ]
          }
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "name"
            ]
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "hint": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "name",
              "description"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ]
    },
    "defaults": {
      "type": "object",
      "properties": {
        "stepMode": {
          "enum": [
            "auto",
            "manual"
          ]
        },
        "delayMs": {
          "type": "number",
          "minimum": 0
        },
        "chunkSize": {
          "type": "integer",
          "minimum": 1
        },
        "chunkDelayMs": {
          "type": "number",
          "minimum": 0
        },
        "announcePause": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "match": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "any": {
                    "const": true
                  }
                },
                "additionalProperties": false,
                "required": [
                  "any"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "equals": {
                    "type": "string"
                  },
                  "ignoreCase": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "equals"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "contains": {
                    "type": "string"
                  },
                  "ignoreCase": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "contains"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "regex": {
                    "type": "string"
                  },
                  "ignoreCase": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "regex"
                ]
              }
            ]
          },
          "once": {
            "type": "boolean"
          },
          "steps": {
            "$ref": "#/$defs/steps"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "match",
          "steps"
        ]
      }
    },
    "fallback": {
      "$ref": "#/$defs/steps"
    }
  },
  "$defs": {
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "message"
            },
            "step": {
              "enum": [
                "auto",
                "manual"
              ]
            },
            "delayMs": {
              "type": "number",
              "minimum": 0
            },
            "label": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "chunked": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "integer",
                  "minimum": 1
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ],
          "title": "message"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "thought"
            },
            "step": {
              "enum": [
                "auto",
                "manual"
              ]
            },
            "delayMs": {
              "type": "number",
              "minimum": 0
            },
            "label": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "chunked": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "integer",
                  "minimum": 1
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ],
          "title": "thought"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "plan"
            },
            "step": {
              "enum": [
                "auto",
                "manual"
              ]
            },
            "delayMs": {
              "type": "number",
              "minimum": 0
            },
            "label": {
              "type": "string"
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string"
                  },
                  "status": {
                    "enum": [
                      "pending",
                      "in_progress",
                      "completed"
                    ]
                  },
                  "priority": {
                    "enum": [
                      "high",
                      "medium",
                      "low"
                    ]
                  }
                },
                "additionalProperties": false,
                "required": [
                  "content",
                  "status",
                  "priority"
                ]
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "entries"
