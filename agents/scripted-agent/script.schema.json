                ]
              }
            },
            "content": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "text"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "diff": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string"
