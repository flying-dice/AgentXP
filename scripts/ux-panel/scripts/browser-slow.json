{
  "$schema": "../../../agents/scripted-agent/script.schema.json",
  "name": "browser-slow",
  "description": "A slow Browser job for T28.2: opens the page given in the prompt (\"... chat app at <url>\"), then reads it again every 1.8 seconds for about a minute, so that the Browser activity bar (it stays 8 seconds after the last announced action; browser_read does not announce, so every cycle also scrolls to the top, H-27) is always on screen and the user can take control. Ends with the message SLOW DONE.",
  "agent": {
    "name": "scripted-agent",
    "version": "1.0.0"
  },
  "rules": [
    {
      "id": "slow",
      "match": {
        "regex": "chat app at (http\\S+)"
      },
      "steps": [
        {
          "type": "message",
          "text": "Opening the page.\n"
        },
        {
          "type": "mcpCall",
          "server": "agentxp",
          "tool": "browser_navigate",
          "arguments": {
            "url": "{{match.1}}"
          },
          "saveAs": "nav",
          "label": "open the page"
        },
        {
          "type": "wait",
          "ms": 1800
        },
        {
          "type": "mcpCall",
          "server": "agentxp",
          "tool": "browser_read",
          "arguments": {
            "mode": "tree"
          },
          "saveAs": "r1",
          "label": "read 1"
        },
        {
          "type": "mcpCall",
          "server": "agentxp",
          "tool": "browser_scroll",
          "arguments": {
            "direction": "top"
          },
          "saveAs": "s1",
          "label": "scroll 1"
        },
        {
          "type": "wait",
          "ms": 1800
        },
